{
  "name": "packweaver",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build:tsc": "tsc",
    "build:vite": "vite build",
    "build": "npm-run-all -c build:tsc build:vite",
    "preview": "vite preview",
    "tauri": "tauri",
    "test:ui": "vitest",
    "test:rust": "cargo test --manifest-path src-tauri/Cargo.toml",
    "test": "vitest run && cargo test --manifest-path src-tauri/Cargo.toml",
    "check:prettier": "prettier --check \"src/**/*.{ts,tsx,css,json}\"",
    "check:eslint": "eslint \"src/**/*.{ts,tsx}\"",
    "check:tsc": "tsc --noEmit",
    "check:cargo-fmt": "cargo fmt --manifest-path src-tauri/Cargo.toml --check",
    "check:cargo-clippy": "cargo clippy --manifest-path src-tauri/Cargo.toml -- -D warnings",
    "check": "npm-run-all -c check:prettier check:eslint check:tsc check:cargo-fmt check:cargo-clippy",
    "fix:prettier": "prettier --write \"src/**/*.{ts,tsx,css,json}\"",
    "fix:eslint": "eslint \"src/**/*.{ts,tsx}\" --fix",
    "fix:cargo-fmt": "cargo fmt --manifest-path src-tauri/Cargo.toml",
    "fix": "npm-run-all -c fix:prettier fix:eslint fix:cargo-fmt",
    "update:all": "pnpm up && cargo update --manifest-path src-tauri/Cargo.toml",
    "build:zip:win": "pnpm tauri build && powershell -Command \"Compress-Archive -Path src-tauri\\target\\release\\packweaver.exe -DestinationPath packweaver-windows.zip -Force\"",
    "prepare": "husky"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.11.1",
    "@tauri-apps/plugin-dialog": "^2.7.2",
    "@tauri-apps/plugin-opener": "^2.5.4",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tailwindcss/vite": "^4.3.3",
    "@tauri-apps/cli": "^2.11.4",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.2",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.0.5",
    "eslint": "^10.8.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.4",
    "happy-dom": "^20.11.2",
    "husky": "^9.1.7",
    "jsdom": "^30.0.1",
    "lint-staged": "^17.3.0",
    "npm-run-all": "^4.1.5",
    "prettier": "^3.9.6",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.0",
    "typescript-eslint": "^8.67.0",
    "vite": "^8.2.1",
    "vitest": "^4.1.11"
  },
  "lint-staged": {
    "src/**/*.{ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "src/**/*.{css,json}": "prettier --write"
  }
}
